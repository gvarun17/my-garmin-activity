# Copy to .env and fill in your own values. Never commit .env.
# These are placeholders only. No real secrets are in this file.

# InfluxDB 2.7 initial setup.
# Changing these AFTER the first `docker compose up` does not change
# an already-initialised volume. See README Troubleshooting.
INFLUXDB_INIT_USERNAME=admin
INFLUXDB_INIT_PASSWORD=change-me-in-env
INFLUXDB_ORG=garmin
INFLUXDB_BUCKET=fitness
# Admin token created on first init. Grafana provisioning uses this
# same value via environment interpolation. Keep it long and random.
INFLUXDB_TOKEN=change-me-in-env

# Grafana admin login.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-in-env

# Garmin Personal API. Used by the auth story onwards.
# The long-lived key goes here, never the 24-hour access token.
# Never commit .env.
GARMIN_API_KEY=change-me-in-env
# Local token cache file (gitignored). Default is .garmin-token.json
# in the repo root when run from the repo root.
GARMIN_TOKEN_CACHE=.garmin-token.json
# Mint a new token when the cached one has less than this many
# seconds left. Default 3600 (1 hour).
GARMIN_TOKEN_REFRESH_THRESHOLD_SECONDS=3600
# Sync service settings. INFLUXDB_URL is http://localhost:8086 when
# running locally, and http://influxdb:8086 inside Docker Compose
# (the compose file already sets that override for the sync service).
INFLUXDB_URL=http://localhost:8086
GARMIN_TIMEZONE=Asia/Kolkata
GARMIN_REQUEST_DELAY_SECONDS=0.8
